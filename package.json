  },
  "homepage": "https://github.com/OpenIngenium/search_server#readme",
  "bugs": {
    "url": "https://github.com/OpenIngenium/search_server/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
